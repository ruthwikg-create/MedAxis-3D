# --- Frontend/API ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Authentication ---
AUTH_REQUIRED=false
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=480
ALLOW_SELF_REGISTER=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-strong-password

# --- Persistence ---
# Example PostgreSQL: postgresql+psycopg://medaxis:password@localhost:5432/medaxis
DATABASE_URL=sqlite:///./medaxis-dev.db
PERSISTENCE_ENABLED=true

# --- S3-compatible object storage ---
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_STRICT=false

# --- Upload / archive limits ---
MAX_UPLOAD_BYTES=536870912
MAX_ZIP_FILES=10000
MAX_ZIP_UNCOMPRESSED_BYTES=4294967296

# --- MONAI runtime ---
MODEL_DOWNLOAD_TIMEOUT=1800
MODEL_INFERENCE_TIMEOUT=3600

# --- Cross-modality synthesis ---
# Must point to a TorchScript model trained/validated for your specific paired dataset.
CROSS_MODALITY_MODEL_PATH=./models/cross_modality/ct_to_mri.ts

# PostgreSQL pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800


# Production deployment checklist
# AUTH_REQUIRED=true
# DATABASE_URL=postgresql+psycopg://medaxis:change-me@localhost:5432/medaxis
# S3_BUCKET=medaxis-imaging
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
